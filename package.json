{
  "name": "ghost-environment",
  "version": "1.0.0",
  "description": "Zero-configuration local proxy server to intercept ECONNREFUSED and mock responses based on OpenAPI.",
  "main": "dist/index.js",
  "bin": {
    "ghost-env": "./dist/index.js"
  },
  "scripts": {
    "start": "ts-node src/index.ts",
    "dev": "nodemon src/index.ts",
    "build": "tsc"
  },
  "dependencies": {
    "@apidevtools/swagger-parser": "^10.1.0",
    "@faker-js/faker": "^8.4.1",
    "commander": "^11.0.0",
    "express": "^4.19.2",
    "http-proxy-middleware": "^3.0.0",
    "openapi-types": "^12.1.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.12.7",
    "nodemon": "^3.1.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  }
}
